{
  "name": "magic-pdf",
  "private": true,
  "version": "1.12.4",
  "description": "MagicPDF Pro Studio — The Modern PDF Workbench",
  "author": "MagicPDF",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/matfigueroac/MagicPDF.git"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "test": "playwright test",
    "dev": "concurrently -k -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run server\" \"npm run client\"",
    "client": "vite",
    "server": "tsx watch server/index.ts",
    "app": "electron .",
    "build:server": "tsc -p tsconfig.server.json && esbuild server/index.ts --bundle --platform=node --format=cjs --outfile=dist-server/index.cjs --external:electron && node scripts/prepare-ocr.cjs",
    "build": "tsc -b && vite build && npm run build:server",
    "dist": "npm run build && electron-builder --win nsis --publish never",
    "dist:all": "npm run build && electron-builder --win nsis portable --publish never",
    "dist:release": "npm run build && node scripts/build-windows-release.cjs"
  },
  "build": {
    "appId": "com.magicpdf.pro",
    "productName": "MagicPDF Pro",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-server/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "LICENSE-MagicPDF.txt"
      },
      {
        "from": "dist-ocr",
        "to": "ocr",
        "filter": [
          "worker.cjs",
          "*.traineddata.gz",
          "cores/LICENSE",
          "cores/tesseract-core.{cjs,wasm}",
          "cores/tesseract-core-simd.{cjs,wasm}"
        ]
      },
      {
        "from": "bin",
        "to": "bin"
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ],
      "fileAssociations": [
        {
          "ext": "pdf",
          "name": "PDF Document",
          "description": "MagicPDF Document",
          "role": "Editor"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MagicPDF Pro",
      "artifactName": "MagicPDF-Pro-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "MagicPDF-Pro-${version}-Portable.${ext}"
    }
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/spa": "^1.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "2.3.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "clsx": "^2.1.1",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "electron": "^44.9.1",
    "electron-builder": "^26.7.1",
    "esbuild": "0.28.2",
    "express": "^4.21.2",
    "lucide-react": "^1.16.0",
    "multer": "2.5.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "postcss": "^8.5.3",
    "prettier": "3.9.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^3.4.17",
    "tesseract.js": "^6.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "wait-on": "^9.0.4"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  }
}
