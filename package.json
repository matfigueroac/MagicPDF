{
  "name": "magic-pdf",
  "private": true,
  "version": "1.0.0",
  "description": "MagicPDF Pro Studio — The Modern PDF Workbench",
  "author": "MagicPDF",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run server\" \"npm run client\"",
    "client": "vite",
    "server": "tsx watch server/index.ts",
    "app": "electron .",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=cjs --outfile=dist-server/index.cjs --external:electron",
    "build": "tsc -b && vite build && npm run build:server",
    "dist": "npm run build && electron-builder --win nsis",
    "dist:all": "npm run build && electron-builder --win nsis portable"
  },
  "build": {
    "appId": "com.magicpdf.pro",
    "productName": "MagicPDF Pro",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-server/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin"
      }
    ],
    "win": {
      "target": ["nsis", "portable"],
      "fileAssociations": [
        {
          "ext": "pdf",
          "name": "PDF Document",
          "description": "MagicPDF Document",
          "role": "Editor"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MagicPDF Pro",
      "artifactName": "MagicPDF-Pro-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "MagicPDF-Pro-${version}-Portable.${ext}"
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^1.16.0",
    "multer": "^1.4.5-lts.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.7.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "wait-on": "^9.0.4"
  }
}
